---
import type { Props } from '@astrojs/starlight/props';

const isHomepage = Astro.url.pathname === '/summer2026/';
---

<div class={`two-column-layout lg:sl-flex${isHomepage ? ' is-homepage' : ''}`}>
	{
		!isHomepage ? (
      Astro.locals.starlightRoute.toc && (
        <aside class="right-sidebar-container print:hidden">
          <div class="right-sidebar">
            <slot name="right-sidebar" />
          </div>
        </aside>
				<div class="main-pane"><slot /></div>
      )
    ) : (
			<div class="main-pane" style={`--sl-content-width: 100%`}><slot /></div>
		)
	}
	
</div>

<style>
	@layer starlight.core {
		.main-pane {
			isolation: isolate;
		}

		@media (min-width: 72rem) {
      /* この値をいじるとPC画面でのトップページの幅が変化 */
			.two-column-layout.is-homepage .main-pane {
				--sl-content-pad-x: 8rem;
			}

			.two-column-layout:not(.is-homepage) .right-sidebar-container {
				order: 2;
				position: relative;
				width: calc(
					var(--sl-sidebar-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
				);
			}

			.two-column-layout:not(.is-homepage) .right-sidebar {
				position: fixed;
				top: 0;
				border-inline-start: 1px solid var(--sl-color-hairline);
				padding-top: var(--sl-nav-height);
				width: 100%;
				height: 100vh;
				overflow-y: auto;
				scrollbar-width: none;
			}

			.two-column-layout:not(.is-homepage) .main-pane {
				width: 100%;
			}

			:global([data-has-sidebar][data-has-toc]) .two-column-layout:not(.is-homepage) .main-pane {
				--sl-content-margin-inline: auto 0;

				order: 1;
				width: calc(
					var(--sl-content-width) + (100% - var(--sl-content-width) - var(--sl-sidebar-width)) / 2
				);
			}
		}
	}
</style>
