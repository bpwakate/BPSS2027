---
import type { HTMLAttributes } from 'astro/types';
import {Icon } from '@astrojs/starlight/components';
import { Image, Picture } from 'astro:assets';

interface Props extends Omit<HTMLAttributes<'a'>, 'title'> {
	title: string;
	name: string;
	affiliation: string;
	image: any;
}

const { title, name, affiliation, image,  ...attributes } = Astro.props;
---

<div class="sl-link-card">
  <div class="sl-flex">
    <Image
      src={image}
      alt={name}
      width=50
      class="lectureImage lectureImage-sm"
    />
		<Image
      src={image}
      alt={name}
      width=100
      class="lectureImage lectureImage-lg"
    />
    <div class="sl-flex stack info">
      <a {...attributes}>
        <span class="title" set:html={title} />
      </a>
      <span class="name" set:html={name} />
      <span class="affiliation" set:html={affiliation} />
    </div>
  </div>
	<Icon name="right-arrow" size="1.333em" class="icon rtl:flip" />
</div>

<style>
	@layer starlight.components {
		.sl-link-card {
			display: grid;
			grid-template-columns: 1fr auto 0fr;
			gap: 0.5rem;
      /* margin: 0.5rem; */
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.5rem;
			padding: 1rem;
			box-shadow: var(--sl-shadow-sm);
			position: relative;
		}

		@media (max-width: 50rem) {
				.sl-link-card {
				padding: 0.7rem;
				gap: 0rem;
			}
		}

		a {
			text-decoration: none;
			line-height: var(--sl-line-height-headings);
		}

		/* a11y fix for https://github.com/withastro/starlight/issues/487 */
		a::before {
			content: '';
			position: absolute;
			inset: 0;
		}

		.stack {
			flex-direction: column;
			gap: 0.5rem;
		}

		.title {
			color: var(--sl-color-white);
			font-weight: 600;
			font-size: var(--sl-text-lg);
		}

		@media (max-width: 50rem) {
			.title {
				font-size: var(--sl-text-base);
			}
		}

		.name {
			color: var(--sl-color-gray-3);
			line-height: 1.5;
		}
		@media (max-width: 50rem) {
			.name {
				font-size: var(--sl-text-sm);
			}
		}

		.affiliation {
			color: var(--sl-color-gray-3);
			line-height: 1.5;
		}
		@media (max-width: 50rem) {
			.affiliation {
				font-size: var(--sl-text-sm);
			}
		}

		.icon {
			color: var(--sl-color-gray-3);
		}

		/* Hover state */
		.sl-link-card:hover {
			background: var(--sl-color-gray-7, var(--sl-color-gray-6));
			border-color: var(--sl-color-gray-2);
		}

		.sl-link-card:hover .icon {
			color: var(--sl-color-white);
		}

    .lectureImage {
      object-fit: contain;
      /* border-radius: 50%; */
    }

		.lectureImage-sm {
			display: none;
		}

		@media (max-width: 50rem) {
			.lectureImage-sm {
				display: block;
			}
			.lectureImage-lg {
				display: none;
			}
		}

    .info {
      padding: 0rem 1rem;
    }
	}
</style>
